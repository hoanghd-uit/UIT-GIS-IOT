# ==============================================================================
# GIS-UIT Building E Digital Twin - Small Phase 04 Environment Configuration
# ==============================================================================
# DO NOT store real secrets in this example file.
# Copy this file to .env.phase04.local and populate secure values.
# .env.phase04.local is gitignored and will never be committed.

# --- PostgreSQL Container Configuration ---
POSTGRES_IMAGE=postgres:17-bookworm
POSTGRES_PORT=5432
POSTGRES_DB=gis_uit_dev
POSTGRES_ADMIN_USER=gis_bootstrap
POSTGRES_ADMIN_PASSWORD=example_bootstrap_secret_min16chars

# --- Database Migration Role ---
DB_MIGRATION_USER=gis_migration_owner
DB_MIGRATION_PASSWORD=example_migration_secret_min16chars

# --- Database Runtime Role (Least-Privilege) ---
DB_APP_USER=gis_app_runtime
DB_APP_PASSWORD=example_runtime_secret_min16chars

# --- NestJS Backend Application ---
APP_ENV=local
HOST=127.0.0.1
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gis_uit_dev

# --- Fixture and Source Mode Controls ---
# Options: 'disabled' (default), 'fixture' (local testing only), 'iot' (reserved)
DEVICE_SOURCE_MODE=fixture
ALLOW_FIXTURES=true
DEVICE_SOURCE_NAMESPACE=phase04-fixture-v1
ENABLE_LOCAL_POSITION_EDITING=true

# --- Next.js Web Proxy Configuration ---
NEST_BACKEND_URL=http://127.0.0.1:3001

